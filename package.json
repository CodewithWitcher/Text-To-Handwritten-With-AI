{
  "name": "text-to-handwriting-ai",
  "version": "2.0.0",
  "description": "Turn typed text into realistic handwritten pages and full assignments (front page, AI answers, templates). Runs locally in your browser.",
  "keywords": [
    "handwriting",
    "text-to-handwriting",
    "assignment",
    "pdf",
    "ai",
    "claude",
    "deepseek",
    "front-page",
    "ignou"
  ],
  "homepage": "https://codewithwitcher.github.io/Text-To-Handwritten-With-AI/",
  "bugs": {
    "url": "https://github.com/CodewithWitcher/Text-To-Handwritten-With-AI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodewithWitcher/Text-To-Handwritten-With-AI.git"
  },
  "license": "MIT",
  "author": "CodewithWitcher (https://github.com/CodewithWitcher)",
  "main": "bin/cli.mjs",
  "bin": {
    "text-to-handwriting-ai": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "index.html",
    "manifest.webmanifest",
    "css/",
    "js/",
    "fonts/",
    "images/",
    "sample.jpeg",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/cli.mjs",
    "dev": "node bin/cli.mjs --no-open",
    "start:python": "python3 server.py",
    "test": "cypress run",
    "lint": "eslint \"js/**/*.mjs\" bin/cli.mjs",
    "eslint": "eslint --fix \"js/**/*.mjs\"",
    "prettier": "prettier --write \"./index.html\" \"js/**/*.mjs\" \"css/**.css\"",
    "format": "npm run prettier",
    "cy": "cypress open"
  },
  "devDependencies": {
    "cypress": "^4.4.1",
    "eslint": "^7.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-prettier": "^3.1.3",
    "prettier": "^2.0.5"
  }
}
